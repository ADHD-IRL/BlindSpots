{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@mae/core": ["packages/core/src/index.ts"],
      "@mae/core/*": ["packages/core/src/*"],
      "@mae/store": ["packages/store/src/index.ts"],
      "@mae/store/*": ["packages/store/src/*"],
      "@mae/fields": ["packages/fields/src/index.ts"],
      "@mae/fields/*": ["packages/fields/src/*"],
      "@mae/runtime": ["packages/runtime/src/index.ts"],
      "@mae/runtime/*": ["packages/runtime/src/*"],
      "@mae/ui": ["packages/ui/src/index.ts"],
      "@mae/ui/*": ["packages/ui/src/*"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "*.ts", "fixtures/**/*.ts"]
}
